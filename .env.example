# ===========================================
# Ahad Co - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to GitHub!
# ===========================================

# Email Service (Brevo / Sendinblue - Free 300 emails/day)
# Sign up at https://www.brevo.com/ (no credit card)
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=Ahad Co

# ----- DATABASE (PICK ONE) -----
# Option A: PostgreSQL (RECOMMENDED for Render free tier - DATA PERSISTS)
# Sign up free at https://supabase.com/ (500MB free, no credit card)
# or https://neon.tech/ (512MB free)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres

# Option B: SQLite (local dev only - file gets WIPED on Render redeploy)
# DB_PATH=/app/data/database.db

# OTP Settings
OTP_EXPIRY_MINUTES=10

# Python Version
PYTHON_VERSION=3.11
